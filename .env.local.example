# Copy this file to .env.local and fill in your Azure Cosmos DB details to
# switch the site from browser-only localStorage to a real, shared database.
# Leave these unset and the app keeps working exactly as it does today.

COSMOS_ENDPOINT=
COSMOS_KEY=

# Optional — these default to the values below if left unset.
# COSMOS_DATABASE=firstchoiceautomotive
# COSMOS_CONTAINER=cars
